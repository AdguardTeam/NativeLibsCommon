diff --git a/include/openssl/ssl.h b/include/openssl/ssl.h
index 618fb74..8b9e0de 100644
--- a/include/openssl/ssl.h
+++ b/include/openssl/ssl.h
@@ -1503,6 +1503,9 @@ DEFINE_CONST_STACK_OF(SSL_CIPHER)
 #define SSL_CIPHER_PSK_WITH_AES_128_CBC_SHA 0x008c
 #define SSL_CIPHER_PSK_WITH_AES_256_CBC_SHA 0x008d
 #define SSL_CIPHER_RSA_WITH_3DES_EDE_CBC_SHA 0x000a
+// Re-added for Safari ClientHello imitation.
+#define SSL_CIPHER_ECDHE_ECDSA_WITH_3DES_EDE_CBC_SHA 0xc008
+#define SSL_CIPHER_ECDHE_RSA_WITH_3DES_EDE_CBC_SHA 0xc012
 
 // The following constants are not cipher suites, but are used in the protocol
 // as signalling values.
diff --git a/ssl/ssl_cipher.cc b/ssl/ssl_cipher.cc
index 1ef231c..2603f67 100644
--- a/ssl/ssl_cipher.cc
+++ b/ssl/ssl_cipher.cc
@@ -165,6 +165,18 @@ static constexpr SSL_CIPHER kCiphers[] = {
         SSL_HANDSHAKE_MAC_SHA256,
     },
 
+    // Cipher C008
+    {
+        "ECDHE-ECDSA-DES-CBC3-SHA",
+        "TLS_ECDHE_ECDSA_WITH_3DES_EDE_CBC_SHA",
+        SSL_CIPHER_ECDHE_ECDSA_WITH_3DES_EDE_CBC_SHA,
+        SSL_kECDHE,
+        SSL_aECDSA,
+        SSL_3DES,
+        SSL_SHA1,
+        SSL_HANDSHAKE_MAC_DEFAULT,
+    },
+
     // Cipher C009
     {
         TLS1_TXT_ECDHE_ECDSA_WITH_AES_128_CBC_SHA,
@@ -189,6 +201,18 @@ static constexpr SSL_CIPHER kCiphers[] = {
         SSL_HANDSHAKE_MAC_DEFAULT,
     },
 
+    // Cipher C012
+    {
+        "ECDHE-RSA-DES-CBC3-SHA",
+        "TLS_ECDHE_RSA_WITH_3DES_EDE_CBC_SHA",
+        SSL_CIPHER_ECDHE_RSA_WITH_3DES_EDE_CBC_SHA,
+        SSL_kECDHE,
+        SSL_aRSA_SIGN,
+        SSL_3DES,
+        SSL_SHA1,
+        SSL_HANDSHAKE_MAC_DEFAULT,
+    },
+
     // Cipher C013
     {
         TLS1_TXT_ECDHE_RSA_WITH_AES_128_CBC_SHA,
@@ -1045,6 +1069,9 @@ bool ssl_create_cipher_list(UniquePtr<SSLCipherPreferenceList> *out_cipher_list,
       SSL_CIPHER_PSK_WITH_AES_128_CBC_SHA,
       SSL_CIPHER_RSA_WITH_AES_256_CBC_SHA,
       SSL_CIPHER_PSK_WITH_AES_256_CBC_SHA,
+      // ECDHE-3DES suites re-added for Safari ClientHello imitation.
+      SSL_CIPHER_ECDHE_ECDSA_WITH_3DES_EDE_CBC_SHA,
+      SSL_CIPHER_ECDHE_RSA_WITH_3DES_EDE_CBC_SHA,
       SSL_CIPHER_RSA_WITH_3DES_EDE_CBC_SHA,
   };
 
diff --git a/ssl/ssl_privkey.cc b/ssl/ssl_privkey.cc
index 2947529..bb8f723 100644
--- a/ssl/ssl_privkey.cc
+++ b/ssl/ssl_privkey.cc
@@ -577,9 +577,11 @@ static bool sigalgs_unique(Span<const uint16_t> in_sigalgs) {
 }
 
 static bool set_sigalg_prefs(Array<uint16_t> *out, Span<const uint16_t> prefs) {
-  if (!sigalgs_unique(prefs)) {
-    return false;
-  }
+  // Allow duplicated signature algorithms so browser-imitation
+  // profiles (e.g. Safari) can advertise them verbatim.
+  // Reference the address (not a bare call) so MSVC /W4 /WX does not raise
+  // C4551 while GCC/Clang still see the function as used.
+  (void) &sigalgs_unique;
 
   // Check for invalid algorithms, and filter out |SSL_SIGN_RSA_PKCS1_MD5_SHA1|.
   Array<uint16_t> filtered;
